# Firebase — needed for Google login (Tracker/Todo/Routine/Sigma/Focus require
# login) and for the optional Firestore cloud backup. Browsing the app (Home,
# Profile) still works without these, but no feature can be unlocked.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-only (Vercel → Settings → Environment Variables). NO VITE_ prefix,
# so it never reaches the browser. Used by api/ai.js.
GEMINI_API_KEY=
